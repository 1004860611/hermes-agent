{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/rule-binding.schema.json",
  "title": "Hermes DFM Rule Binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "operation_id", "metric_id", "quantity_id", "rule_id", "operator", "aggregation"],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "metric_id": {"type": "string", "minLength": 1},
    "quantity_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "operator": {"enum": [">=", "<=", ">", "<", "==", "!="]},
    "aggregation": {"enum": ["minimum", "maximum", "mean", "sum", "count", "identity"]}
  }
}
