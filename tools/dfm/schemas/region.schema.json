{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/region.schema.json",
  "title": "Hermes DFM Region",
  "type": "object",
  "additionalProperties": false,
  "required": ["region_id", "input_sha256", "coordinate_system", "mode", "semantic_label", "source_refs", "version", "content_sha256", "bbox", "geometry_refs"],
  "properties": {
    "region_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"type": "string", "minLength": 1},
    "mode": {"enum": ["bbox", "topology_refs", "whole_model"]},
    "semantic_label": {"type": "string"},
    "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bbox": {
      "type": ["object", "null"],
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
        "maximum": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}
      }
    },
    "geometry_refs": {"type": "array", "items": {"type": "object"}}
  }
}
