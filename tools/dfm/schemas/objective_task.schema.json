{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/objective-task.schema.json",
  "title": "Hermes Objective Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "input_sha256", "input_format", "process", "scope_id", "scope_version", "operations", "verification_level", "assumed_pull_direction"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_format": {"type": "string", "minLength": 1},
    "process": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "scope_version": {"type": "string", "minLength": 1},
    "verification_level": {"enum": ["certified", "experimental"]},
    "assumed_pull_direction": {"type": "boolean"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "calculator_id", "depends_on", "metric_ids", "required_quantities", "required_artifacts", "arguments", "algorithm_options"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "calculator_id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "metric_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_quantities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "required_artifacts": {"type": "array", "uniqueItems": true, "items": {"enum": ["preflight", "features", "scalar_field", "render_scene", "topology_map"]}},
          "arguments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resolvedArgument"}},
          "algorithm_options": {"type": "object", "additionalProperties": {"$ref": "#/$defs/resolvedArgument"}}
        }
      }
    }
  },
  "$defs": {
    "resolvedArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_ref", "unit"],
      "properties": {
        "value": {},
        "source_ref": {"type": "string", "minLength": 1},
        "unit": {"type": ["string", "null"]}
      }
    }
  }
}
