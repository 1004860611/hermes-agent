{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/dfm/render-scene.schema.json",
  "title": "Hermes DFM Neutral Render Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "run_id", "input_sha256", "coordinate_system", "unit", "primitives"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "coordinate_system": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primitive_id", "vertices", "triangles"],
        "properties": {
          "primitive_id": {"type": "string", "minLength": 1},
          "vertices": {"type": "array", "items": {"$ref": "#/$defs/point3"}},
          "triangles": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
