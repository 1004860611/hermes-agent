    "min_hole_diameter_mm": {"value": 2.5, "unit": "mm"},
    "min_tool_radius_mm": {"value": 0.8, "unit": "mm"},
    "min_slot_width_mm": {"value": 1.0, "unit": "mm"},
    "min_machining_gap_mm": {"value": 0.8, "unit": "mm"},
    "min_draft_deg": {"value": 1.0, "unit": "degree"},
    "max_planar_step_mm": {"value": 0.5, "unit": "mm"},
    "local_boss_thickness_ratio": {"value": 4.0, "unit": "ratio"},
    "max_local_boss_span_mm": {"value": 25.0, "unit": "mm"},
    "min_hole_edge_distance_mm": {"value": 1.0, "unit": "mm"},
    "min_hole_web_mm": {"value": 1.0, "unit": "mm"},
    "max_hole_depth_ratio": {"value": 6.0, "unit": "ratio"}
  },
  "operations": [
